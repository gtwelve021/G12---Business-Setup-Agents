{
  "name": "g12-chatgpt-app",
  "version": "1.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc && node scripts/copy-assets.mjs",
    "start": "node dist/server.js",
